{% extends 'base.html.twig' %}

{% block title %}会員登録画面{% endblock %}

{% block body %}
<!-- <style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style> -->

<div class="example-wrapper">
    <h1 class="title">会員登録</h1>
    {{ form_start(form) }}

        {{ form_row(form._token) }}
            <!-- 名前 -->
            <div class="input_row">
                <div class="div_w_95">
                    <label class ="input_label" for="name">名前</label>
                    {{ form_widget(form.name, {'attr': {'class': 'text_input'}}) }}
                    {{ form_errors(form.name) }}
                </div>
            </div>

            <!-- 名前（カナ） -->
            <div class="input_row">
                <label class ="input_label" for="name">名前（カナ）</label>
                {{ form_widget(form.name_kana, {'attr': {'class': 'text_input'}}) }}
                {{ form_errors(form.name_kana) }}
            </div>

            <!-- メールアドレス -->
            <div class="input_row">
                <label class="input_label" for="email">メールアドレス</label>
                {{ form_widget(form.email, {'attr': {'class': 'text_input_w100'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <!-- パスワード -->
            <div class="input_row">
                <label class="input_label" for="password">パスワード</label>
                <input class="text_input_w100" id="password" type="password" name="{{ form.password.vars.full_name }}">
                {{ form_errors(form.password) }}
                <div id="js-error-password" class="error_message"></div>
            </div>

            <!-- パスワード確認 -->
            <div class="input_row">
                <label class="input_label" for="password">パスワード（確認）</label>
                <input class="text_input_w100" id="password_confirm" type="password" name="password_confirm">
                <div id="js-error-confirm" class="error_message"></div>
            </div>

            <!-- 送信ボタン -->
            <input class="submit_btn" type="submit" value="送信">
    {{ form_end(form, { 'render_rest': false }) }}
</div>
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/validation.js') }}"></script>
{% endblock %}

{% endblock %}
