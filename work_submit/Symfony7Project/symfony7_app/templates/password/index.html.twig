{% extends 'base.html.twig' %}

{% block title %}パスワード再設定{% endblock %}

{% block body %}

<div class="example-wrapper">
    <h1>パスワード再設定</h1>
    <p>メールアドレスと新しいパスワードを入力してください</p>

    {% for message in app.flashes('error') %}
        <div>{{ message }}</div>
    {% endfor %}

    <form method="post">
        <div class="input_row">
            <label class="input_label" for="email">メールアドレス</label>
            <input type="email" name="email" required>
        </div>

        <div class="input_row">
            <label class="input_label" for="password">新しいパスワード</label>
            <input type="password" name="password" required>
        </div>

        <div class="input_row">
            <label class="input_label" for="password">新しいパスワード(確認)</label>
            <input type="password" name="confirm_password" required>
        </div>

        <button type="submit" class="submit_btn">送信</button>
    </form>
</div>
{% endblock %}
